{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "frontend/dist" }
    },
    {
      "src": "frontend/api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/frontend/api/server.js" },
    { "src": "/images/(.*)", "dest": "/frontend/api/server.js" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
