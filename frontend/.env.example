# put this file in frontend/.env during local development if you run the
# backend on a different port (e.g. while using the old backend/ folder).
# When the frontend and API are served together (e.g. via `vercel dev` or a
# production Vercel deployment) you can leave VITE_API_BASE blank or omit the
# file entirely, and requests will be made relative to the same origin.
VITE_API_BASE=http://localhost:4000

# for GitHub-based content updates; a token is required in all
# environments (backend will error without it).
#GITHUB_TOKEN=ghp_...
#GITHUB_REPOSITORY=owner/repo
#GITHUB_BRANCH=main
